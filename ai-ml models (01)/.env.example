# HC-POS AI Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your real credentials.
# NEVER commit the .env file to version control.
#
# Usage:
#   cp .env.example .env
#   nano .env   (or open in any text editor)

# ── NVIDIA AI Endpoints ───────────────────────────────────────────────────────
# The LLM powering the Genesis AI conversational agent.
# Get your free API key at: https://build.nvidia.com/
NVIDIAGS_API_KEY=nvapi-YOUR_NVIDIA_API_KEY_HERE

# ── Supabase (Backend — Service Role Key) ─────────────────────────────────────
# Used by the Python backend to write decisions, forecasts, and system state.
# Uses the SERVICE ROLE key (not the anon key) to bypass Row-Level Security.
#
# Get from: Supabase Dashboard > Settings > API > service_role (secret)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ── Supabase User ID (Optional but Recommended) ───────────────────────────────
# The auth.users UUID of the household owner.
# If omitted, the backend will attempt to discover it from existing database rows.
# Get it from: Supabase Dashboard > Authentication > Users
SUPABASE_USER_ID=YOUR_AUTH_USERS_UUID_HERE

# ── Optional: Alternative LLM Providers (uncomment to enable) ─────────────────
# MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY_HERE
# FIRECRAWL_API_KEY=YOUR_FIRECRAWL_API_KEY_HERE
